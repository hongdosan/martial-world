# dependencies (FE 자산은 frontend/ 하위 — 2026-05-08 모노레포 이전)
/frontend/node_modules
/node_modules
/.pnp
.pnp.js

# testing
/frontend/coverage

# production
/frontend/build
/frontend/dist

# Gradle (settings.gradle 스켈레톤 — M8. build/ 캐시는 도메인 모듈 include 후 발생)
/.gradle/
/backend/**/build/
/backend/**/.gradle/

# env (frontend/.env 와 frontend/.env.example 는 공개 기본값/템플릿 — 커밋 대상)
# 실제 개발·로컬 값은 아래 목록으로 차단 (비밀 유출 방지)
/frontend/.env.local
/frontend/.env.development.local
/frontend/.env.test.local
/frontend/.env.production.local
/frontend/.env.dev

# private config submodule content (symlink targets)
# .private-config/ 자체는 서브모듈로 추적되며, 아래는 symlink이 생성될 경로
# (.claude/ 전체가 이미 ignore 되므로 .claude/agents, .claude/artifact symlink 은 자동 제외)

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/logs/

# OS
.DS_Store
Thumbs.db

# IDE
.idea
*.iml
.vscode
*.swp
*.swo
*~

# Claude Code
/.claude/

# 사용자 원본 프롬프트 / 플랜 문서 (공개 저장 대상 아님, 심링크 포함)
/docs/plans/
